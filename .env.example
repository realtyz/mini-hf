TZ=Asia/Shanghai

# ============================================================================
# Frontend runtime config (injected into the SPA at container start)
# ============================================================================
API_BASE_URL=http://localhost:9800/api/v1
HF_SERVER_URL='http://localhost:9801'
EMAIL_DOMAIN='mini-hf.com'

# Public URL of the HF API server. Used in pagination links and download URLs
# returned to HF clients. Set this to the host/port the HF API is reachable at
# from the LAN (NOT localhost — clients on other machines need to reach it).
APP_HF_SERVER_URL=http://localhost:9801

# ============================================================================
# Admin user (auto-created on first startup) — CHANGE BEFORE PRODUCTION
# ============================================================================
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme

# ============================================================================
# JWT & secrets — CHANGE BEFORE PRODUCTION
# ============================================================================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encryption key for sensitive config values stored in the DB (e.g. SMTP
# password). Falls back to JWT_SECRET_KEY when unset.
# CONFIG_ENCRYPTION_KEY=

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
# PG_HOST / PG_PORT are overridden inside docker-compose to "postgres:5432".
# For local (non-docker) development, uncomment and point at your local DB.
# PG_HOST=localhost
# PG_PORT=5432
PG_USERNAME=postgres
PG_PASSWORD=123456
PG_DATABASE=mini_hf

# ============================================================================
# Redis
# ============================================================================
# Overridden inside docker-compose to "redis://redis:6379".
# REDIS_URL=redis://localhost:6379

# ============================================================================
# S3-compatible storage (REQUIRED — see README "Prerequisites")
# ============================================================================
# Mini-HF does not ship an S3 service. Point these at your own MinIO / RustFS /
# Ceph RGW / AWS S3 / Aliyun OSS. The bucket must already exist.
# `localhost` here will resolve to the container itself — use the host's LAN IP
# or a DNS name reachable from the Docker network.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=mini-hf-bucket
S3_REGION=us-east-1
S3_USE_SSL=false
S3_VERIFY_SSL=false

# ============================================================================
# Host volume paths (used by docker-compose, ignored otherwise)
# ============================================================================
# Temp dir for partial downloads (mgmt-server side).
# INCOMPLETE_FILE_PATH=./data/incomplete
# Worker scratch dir for in-flight downloads. Both worker / worker-small share
# this path. Must be on a disk with enough free space for the largest repo.
# WORKER_DATA_PATH=./data/worker

# ============================================================================
# Worker tuning (optional — defaults in core/settings.py are sensible)
# ============================================================================
# WORKER_MAX_CONCURRENT=4
# WORKER_CONCURRENT_DOWNLOADS=8
# WORKER_CONCURRENT_UPLOADS=4
# WORKER_CONCURRENT_S3_CHECKS=16
# WORKER_PROGRESS_INTERVAL=2
# WORKER_MAX_RETRIES=3
