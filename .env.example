TZ=Asia/Shanghai

# For huggingface pagination API and frontend docs
APP_HF_SERVER_URL='http://localhost:9801'
# For frontend placeholder
APP_EMAIL_DOMAIN='mini-hf.com'

# Admin User Settings (auto-created on first startup)
# Default: admin@example.com / changeme
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme

# JWT Settings
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Settings
PG_USERNAME=postgres
PG_PASSWORD=123456
PG_DATABASE=mini_hf

# S3 Settings
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=mini-hf-bucket
S3_REGION=us-east-1
S3_USE_SSL=false
S3_VERIFY_SSL=false
